{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".vercel-static",
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "functions": {
    "api/board.js": {
      "maxDuration": 120
    },
    "api/concierge.js": {
      "maxDuration": 60
    },
    "api/owner/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/owner/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
