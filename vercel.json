{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run test:build && npm run build",
  "outputDirectory": ".vercel-static",
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "functions": {
    "api/receptionist-agent.js": {
      "maxDuration": 60,
      "includeFiles": "lib/knowledge/**"
    },
    "api/receptionist-agent/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "lib/knowledge/**"
    },
    "api/board.js": {
      "maxDuration": 120
    },
    "api/concierge.js": {
      "maxDuration": 60
    },
    "api/owner/*.js": {
      "maxDuration": 60
    },
    "api/receptionist.js": {
      "maxDuration": 60
    },
    "api/receptionist-session.js": {
      "maxDuration": 60
    },
    "api/receptionist-swml.js": {
      "maxDuration": 60
    },
    "api/assistant/notify.js": {
      "maxDuration": 30
    },
    "api/frontdesk/message.js": {
      "maxDuration": 60
    },
    "api/frontdesk/sms.js": {
      "maxDuration": 30
    },
    "api/frontdesk/owner.js": {
      "maxDuration": 60
    },
    "api/frontdesk/document.js": {
      "maxDuration": 60
    },
    "api/frontdesk/booking.js": {
      "maxDuration": 60
    },
    "api/frontdesk/missed-call.js": {
      "maxDuration": 30
    },
    "api/voice-report.js": {
      "maxDuration": 120
    },
    "api/voice-report-pdf.js": {
      "maxDuration": 30,
      "includeFiles": "lib/voice-report-fonts/**"
    }
  },
  "headers": [
    {
      "source": "/owner/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/owner/digest",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/owner/digest",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/owner/digest",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/owner/digest",
      "schedule": "0 23 * * *"
    }
  ]
}
